<!DOCTYPE html>
<html lang="kk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Анель | Жеке портфолио</title>
<style>
:root {
  --navy: #12263a;
  --teal: #087f8c;
  --light: #f3f7fa;
  --white: #ffffff;
  --muted: #627487;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: "Segoe UI", Arial, sans-serif;
  color: var(--navy);
  background: var(--light);
  line-height: 1.75;
}
nav {
  background: white;
  padding: 18px 8%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
  box-shadow: 0 2px 15px #12263a12;
}
.logo {
  font-weight: 800;
  font-size: 22px;
  color: var(--teal);
}
nav a {
  text-decoration: none;
  color: var(--navy);
  margin-left: 18px;
  font-size: 14px;
  font-weight: 600;
}
nav a:hover { color: var(--teal); }
.hero {
  background: linear-gradient(125deg,#12263a,#155e75,#087f8c);
  color: white;
  padding: 100px 8%;
}
.hero-inner {
  max-width: 1100px;
  margin: auto;
}
.eyebrow {
  text-transform: uppercase;
  letter-spacing: 3px;
  color: #a4e8e6;
  font-size: 13px;
  font-weight: 700;
}
h1 {
  font-size: clamp(34px,5vw,62px);
  line-height: 1.2;
  margin: 20px 0;
}
.hero p {
  max-width: 750px;
  font-size: 18px;
  color: #e1eef3;
}
.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 30px;
}
.hero-tags span {
  border: 1px solid #ffffff66;
  border-radius: 30px;
  padding: 8px 16px;
  font-size: 13px;
}
.container {
  max-width: 1100px;
  margin: auto;
  padding: 65px 22px;
}
.section-title {
  font-size: 30px;
  margin: 0 0 30px;
}
.section-title:after {
  content: "";
  display: block;
  width: 65px;
  height: 4px;
  background: var(--teal);
  border-radius: 5px;
  margin-top: 12px;
}
.card {
  background: white;
  padding: 32px;
  border-radius: 18px;
  box-shadow: 0 5px 25px #12263a0c;
  margin-bottom: 20px;
}
.card h3 {
  margin: 0 0 8px;
  font-size: 21px;
}
.date {
  color: var(--teal);
  font-weight: 700;
  font-size: 14px;
}
.subtitle { color: var(--muted); }
.grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 20px;
}
.skill {
  background: white;
  border-radius: 15px;
  padding: 24px;
  border-left: 4px solid var(--teal);
  box-shadow: 0 4px 18px #12263a0a;
}
.skill h3 { margin: 0 0 7px; }
.skill p { margin: 0; color: var(--muted); }
ul { padding-left: 22px; }
li { margin-bottom: 10px; }
.highlight {
  background: #e5f5f5;
  padding: 25px;
  border-radius: 15px;
  border-left: 4px solid var(--teal);
}
footer {
  background: var(--navy);
  color: white;
  text-align: center;
  padding: 35px 20px;
}
footer p { color: #b7c9d7; }
@media(max-width:650px) {
  .grid { grid-template-columns: 1fr; }
  .hero { padding: 70px 22px; }
  .card { padding: 24px; }
  nav { padding: 16px 22px; }
  nav a { margin: 0 12px 0 0; }
}
</style>
</head>

